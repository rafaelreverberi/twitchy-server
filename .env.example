# Development only. For LAN clients, set both an accessible base URL and binding.
PUBLIC_BASE_URL=http://localhost:8080
BIND_ADDR=127.0.0.1
PORT=8080
ALLOW_HTTP=true
ADBLOCK=on
MAX_SESSIONS=8
SESSIONS_PER_PRINCIPAL=2
SESSION_LIFETIME=12h
SESSION_IDLE_TTL=2m
SESSION_STARTUP_TIMEOUT=90s
SESSION_MAX_DISK_BYTES=268435456
# Optional verified release image; pin tag AND digest from GitHub Actions.
# TWITCHY_IMAGE=ghcr.io/rafaelreverberi/twitchy-server:0.1.0@sha256:...
# SOURCE_DOMAIN=your-existing-domain
